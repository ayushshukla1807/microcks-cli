{
  "name": "microcks-vscode",
  "displayName": "Microcks",
  "description": "View Microcks services, mock status, and test results directly in VS Code",
  "version": "0.1.0",
  "publisher": "microcks",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Microcks",
      "properties": {
        "microcks.serverUrl": {
          "type": "string",
          "default": "",
          "description": "URL of the Microcks instance (e.g. http://localhost:8585)"
        },
        "microcks.authToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for authentication. Leave empty if the instance has no auth (e.g. local uber image)."
        },
        "microcks.cliPath": {
          "type": "string",
          "default": "microcks-cli",
          "description": "Path to the microcks-cli binary."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "microcksServices",
          "name": "Microcks Services"
        }
      ]
    },
    "commands": [
      {
        "command": "microcks.refresh",
        "title": "Microcks: Refresh Services",
        "icon": "$(refresh)"
      },
      {
        "command": "microcks.configure",
        "title": "Microcks: Configure Server URL"
      },
      {
        "command": "microcks.test",
        "title": "Run Microcks Test",
        "icon": "$(play)"
      },
      {
        "command": "microcks.import",
        "title": "Microcks: Import API Artifact",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "microcks.refresh",
          "when": "view == microcksServices",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "microcks.test",
          "when": "view == microcksServices && viewItem == microcksOperation",
          "group": "inline"
        },
        {
          "command": "microcks.test",
          "when": "view == microcksServices && viewItem == microcksOperation"
        }
      ],
      "explorer/context": [
        {
          "command": "microcks.import",
          "when": "resourceExtname =~ /\\.(yaml|yml|json|wsdl|xml|proto)$/",
          "group": "microcks"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
